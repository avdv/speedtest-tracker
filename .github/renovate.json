{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "helpers:pinGitHubActionDigests"
    ],
    "composer": {
        "enabled": false
    },
    "dockerfile": {
        "enabled": false
    },
    "docker-compose": {
        "enabled": false
    },
    "nix": {
        "enabled": true,
        "lockFileMaintenance": {
            "enabled": true,
            "automerge": true
        }
    },
    "npm": {
        "enabled": false
    }
}